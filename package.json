{
  "name": "rootpath",
  "version": "1.3.0-alpha.2",
  "private": true,
  "description": "Open-source SSH and SFTP client with visual Linux VPS management and reviewed website deployments for macOS and Windows.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "playwright test",
    "test:desktop": "node tests/desktop.cjs",
    "test:connections": "node --test tests/connections.test.cjs",
    "test:ssh-desktop": "node tests/ssh-desktop.cjs",
    "test:files": "node --test tests/files.test.cjs",
    "test:files-desktop": "node tests/files-desktop.cjs",
    "test:transfers": "node --test tests/transfers.test.cjs",
    "test:transfers-desktop": "node tests/transfers-desktop.cjs",
    "test:workspace": "node --test tests/workspace.test.cjs",
    "test:workspace-desktop": "node tests/workspace-desktop.cjs",
    "test:monitoring": "node --test tests/monitoring.test.cjs",
    "test:monitoring-desktop": "node tests/monitoring-desktop.cjs",
    "test:applications": "node --test tests/applications.test.cjs",
    "test:applications-desktop": "node tests/applications-desktop.cjs",
    "test:pm2-live": "node tests/pm2-live.cjs",
    "test:management": "node --test tests/management.test.cjs",
    "test:management-desktop": "node tests/management-desktop.cjs",
    "test:backend": "node --test tests/connections.test.cjs tests/files.test.cjs tests/transfers.test.cjs tests/workspace.test.cjs tests/monitoring.test.cjs tests/applications.test.cjs tests/management.test.cjs tests/logs.test.cjs tests/projects.test.cjs tests/static-trust.test.cjs tests/workflows.test.cjs tests/production.test.cjs tests/storage.test.cjs",
    "package:mac": "npm run build && electron-builder --mac dmg zip --arm64 --publish never",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "test:desktop-all": "node scripts/desktop-regression.cjs",
    "test:logs": "node --test tests/logs.test.cjs",
    "test:logs-desktop": "node tests/logs-desktop.cjs",
    "test:projects": "node --test tests/projects.test.cjs",
    "test:projects-desktop": "node tests/projects-desktop.cjs",
    "test:layout-desktop": "node tests/layout-desktop.cjs",
    "test:static": "python3 tests/static-recipe.py",
    "test:static-desktop": "node tests/static-desktop.cjs",
    "test:application-recipes": "python3 tests/application-recipe.py",
    "test:application-desktop": "node tests/application-desktop.cjs",
    "test:workflows": "python3 tests/workflows.py && node --test tests/workflows.test.cjs",
    "test:workflows-desktop": "node tests/workflows-desktop.cjs",
    "test:production-desktop": "node tests/production-desktop.cjs",
    "test:storage": "node --test tests/storage.test.cjs",
    "test:storage-desktop": "node tests/storage-desktop.cjs",
    "test:websites": "node --experimental-strip-types --test tests/websites.test.mjs",
    "test:websites-desktop": "node tests/websites-desktop.cjs",
    "test:development": "node --test tests/development.test.cjs",
    "test:github-recipes": "python3 tests/github-recipes.py",
    "test:github-desktop": "node tests/github-desktop.cjs",
    "test:guided-desktop": "node tests/guided-desktop.cjs",
    "test:ai": "node --test tests/ai.test.cjs",
    "test:ai-desktop": "node tests/ai-desktop.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.56.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "shell-quote": "^1.12.0",
    "typescript": "^5.7.3",
    "vite": "^8.3.5",
    "wait-on": "^8.0.2"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  },
  "author": "afnanplk",
  "build": {
    "appId": "com.vpsexplorer.desktop",
    "productName": "Rootpath",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/__pycache__/**",
      "!**/*.pyc",
      "!node_modules/monaco-editor/**/*",
      "!node_modules/lucide-react/**/*",
      "!node_modules/react/**/*",
      "!node_modules/react-dom/**/*",
      "!node_modules/scheduler/**/*",
      "!node_modules/@xterm/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/rootpath.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signExecutable": false,
      "icon": "build/rootpath.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/rootpath.ico",
      "uninstallerIcon": "build/rootpath.ico",
      "installerHeaderIcon": "build/rootpath.ico"
    },
    "artifactName": "Rootpath-${version}-${os}-${arch}.${ext}",
    "toolsets": {
      "nsis": "1.2.1"
    }
  },
  "license": "MIT",
  "homepage": "https://github.com/afnanplk/rootpath#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afnanplk/rootpath.git"
  },
  "bugs": {
    "url": "https://github.com/afnanplk/rootpath/issues"
  },
  "keywords": [
    "ssh",
    "sftp",
    "vps",
    "file-manager",
    "deployment",
    "macos",
    "windows",
    "mcp",
    "self-hosted",
    "nginx"
  ]
}
